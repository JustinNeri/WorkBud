# Copy to .env and fill in from your Supabase project settings → API.
# .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# The same two values the client uses. The server queries as the signed-in
# user, so it needs no service-role key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional locally (defaults to 3001). Do NOT set it on a host: the host sets it.
# PORT=3001
