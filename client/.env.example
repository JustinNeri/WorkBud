# Copy to .env and fill in from your Supabase project settings → API.
# .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC. These
# two are designed to be: the anon key grants nothing on its own, and every
# table is behind Row Level Security. Never put any other key in here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
